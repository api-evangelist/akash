              },
              {
                "name": "blockWindow",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "Get the estimated date of a future block."
        },
        {
          "info": {
            "name": "Get the estimated height of a future date and time.",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/v1/predicted-date-height/:timestamp",
            "params": [
              {
                "name": "timestamp",
